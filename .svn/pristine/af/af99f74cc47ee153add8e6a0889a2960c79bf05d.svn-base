/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar la Suspensión de Cheques y Chequeras
 *
 */
public class STOPDSJVBean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el Usuario
	 */
	private String STOSTPUSER;
	
	/**
	 * Parámetro para manejar el Número de Cuenta
	 */
	private String STOSTPACC;
	
	/**
	 * Parámetro para manejar las Observaciones
	 */
	private String STOSTPRMK;
	
	/**
	 * Parámetro para manejar la Fecha de Parada, Día
	 */
	private String STOSTPDT1;
	
	/**
	 * Parámetro para manejar la Fecha de Parada, Mes
	 */
	private String STOSTPDT2;
	
	/**
	 * Parámetro para manejar la Fecha de Parada, Año
	 */
	private String STOSTPDT3;
	
	/**
	 * Parámetro para manejar el Cheque Desde
	 */
	private String STOSTPFCK;
	
	/**
	 * Parámetro para manejar el Cheque Hasta
	 */
	private String STOSTPTCK;
	
	/**
	 * Parámetro para manejar la Referencia de la Transacción
	 */
	private String STOSTPNRE;
	
	
	private String STOSTPF01;
	private String STOSTPF02;

	
	public String getSTOSTPNRE() {
		return STOSTPNRE;
	}
	public void setSTOSTPNRE(String sTOSTPNRE) {
		STOSTPNRE = sTOSTPNRE;
	}
	public String getSTOSTPF01() {
		return STOSTPF01;
	}
	public void setSTOSTPF01(String sTOSTPF01) {
		STOSTPF01 = sTOSTPF01;
	}
	public String getSTOSTPF02() {
		return STOSTPF02;
	}
	public void setSTOSTPF02(String sTOSTPF02) {
		STOSTPF02 = sTOSTPF02;
	}
	public String getSTOSTPUSER() {
		return STOSTPUSER;
	}
	public void setSTOSTPUSER(String sTOSTPUSER) {
		STOSTPUSER = sTOSTPUSER;
	}
	public String getSTOSTPACC() {
		return STOSTPACC;
	}
	public void setSTOSTPACC(String sTOSTPACC) {
		STOSTPACC = sTOSTPACC;
	}
	public String getSTOSTPRMK() {
		return STOSTPRMK;
	}
	public void setSTOSTPRMK(String sTOSTPRMK) {
		STOSTPRMK = sTOSTPRMK;
	}
	public String getSTOSTPDT1() {
		return STOSTPDT1;
	}
	public void setSTOSTPDT1(String sTOSTPDT1) {
		STOSTPDT1 = sTOSTPDT1;
	}
	public String getSTOSTPDT2() {
		return STOSTPDT2;
	}
	public void setSTOSTPDT2(String sTOSTPDT2) {
		STOSTPDT2 = sTOSTPDT2;
	}
	public String getSTOSTPDT3() {
		return STOSTPDT3;
	}
	public void setSTOSTPDT3(String sTOSTPDT3) {
		STOSTPDT3 = sTOSTPDT3;
	}
	public String getSTOSTPFCK() {
		return STOSTPFCK;
	}
	public void setSTOSTPFCK(String sTOSTPFCK) {
		STOSTPFCK = sTOSTPFCK;
	}
	public String getSTOSTPTCK() {
		return STOSTPTCK;
	}
	public void setSTOSTPTCK(String sTOSTPTCK) {
		STOSTPTCK = sTOSTPTCK;
	}
	public String getSTOSTPAMT() {
		return STOSTPAMT;
	}
	public void setSTOSTPAMT(String sTOSTPAMT) {
		STOSTPAMT = sTOSTPAMT;
	}
	public String getSTOSTPPTS() {
		return STOSTPPTS;
	}
	public void setSTOSTPPTS(String sTOSTPPTS) {
		STOSTPPTS = sTOSTPPTS;
	}
	public String getSTOSTPFLG() {
		return STOSTPFLG;
	}
	public void setSTOSTPFLG(String sTOSTPFLG) {
		STOSTPFLG = sTOSTPFLG;
	}
	private String STOSTPAMT;
	private String STOSTPPTS;
	private String STOSTPFLG;

}
