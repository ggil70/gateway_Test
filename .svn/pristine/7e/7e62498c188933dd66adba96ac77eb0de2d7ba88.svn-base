package com.activo.gateway.beans;

/**
 *
 * @author P021102096
 */
public class CobroComisionBean extends ParamsGenerales{


    private String transaccion;  /*Codigo de la Transaccion*/
    private String cuenta;  /*Numero de cuenta a Debitar la comision*/
    private String montoComision;  /*Monto de la comision*/
    private String codigoConfirmacion;  /*CODIGO DE CONFIRMACION*/
    private String descripcion;  /*Descripcion de la Transacion*/

    public String getTransaccion() {
        return transaccion;
    }

    public void setTransaccion(String transaccion) {
        this.transaccion = transaccion;
    }

    public String getCuenta() {
        return cuenta;
    }

    public void setCuenta(String cuenta) {
        this.cuenta = cuenta;
    }

    public String getMontoComision() {
        return montoComision;
    }

    public void setMontoComision(String montoComision) {
        this.montoComision = montoComision;
    }

    public String getCodigoConfirmacion() {
        return codigoConfirmacion;
    }

    public void setCodigoConfirmacion(String codigoConfirmacion) {
        this.codigoConfirmacion = codigoConfirmacion;
    }

    public String getDescripcion() {
        return descripcion;
    }

    public void setDescripcion(String descripcion) {
        this.descripcion = descripcion;
    }

  

    



    
    
}
