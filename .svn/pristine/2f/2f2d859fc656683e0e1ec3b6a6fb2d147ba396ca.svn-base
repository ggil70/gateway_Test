package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar los parámetros para Completa la Cuenta 20
 *
 */
public class EDL890101Bean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el Usuario
	 */
	private String E01USERID;
	
	/**
	 * Parámetro para manejar la Cuenta 10
	 */
	private String E01ACC010;
	
	/**
	 * Parámetro para manejar la Cuenta 20
	 */
	private String E01ACC020;

	public String  getE01USERID() {
		return E01USERID;
	}
	public void setE01USERID(String e01userid) {
		E01USERID  = e01userid;
	}
	public String getE01ACC010() {
		return E01ACC010;
	}
	public void setE01ACC010(String e01acc010) {
		E01ACC010 = e01acc010;
	}
	public String getE01ACC020() {
		return E01ACC020;
	}
	public void setE01ACC020(String e01acc020) {
		E01ACC020 = e01acc020;
	}
