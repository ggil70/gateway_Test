package com.activo.gateway.beans;


/**
 * Clase para el manejo de los Limites Generales del Banco
 * @author Adverweb
 *
 */
public class LimitesGeneralesResponse extends WSResponse{

	/**
	 * Arreglo con los Limites Generales del Banco
	 */

	private LimitesGenerales[] limite;

	/**
	 * @return the limite
	 */
	public LimitesGenerales[] getLimite() {
		return limite;
	}

	/**
	 * @param limite the limite to set
	 */
	public void setLimite(LimitesGenerales[] limite) {
		this.limite = limite;
	}

	
	

	
	
	
}
