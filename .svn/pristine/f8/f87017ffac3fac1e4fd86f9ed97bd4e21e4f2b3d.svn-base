/*
 * Bean con informacion referente al Reverso de una Recarga Billetera Movil
 *
 * Este bean contiene la informacion referente a los datos para una transaccion de reverso.
 *
 * @author Marcel Guglielmelli mguglielmelli@emsys.com
 */
package com.activo.gateway.beans;

public class ReversoBilleteraBean extends ParamsGenerales {
        
    private String referencia;    
    
    public ReversoBilleteraBean() {
		
    }    

    public String getReferencia() {
        return referencia;
    }

    public void setReferencia(String referencia) {
        this.referencia = referencia;
    }   
        
}
