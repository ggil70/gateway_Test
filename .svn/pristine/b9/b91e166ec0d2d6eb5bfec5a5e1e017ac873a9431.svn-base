/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar el Cambio de Límites en Transacciones Vía Internet
 *
 */
public class NIBPF3050Bean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el Tipo de Documento de Identificación
	 */
	private String INTNACLI;
	
	/**
	 * Parámetro para manejar el Número de Documento de Identificación 
	 */
	private String INTIDELI;
	private String INTMLELI;
	private String INTCLELI;
	private String INTMLILI;
	private String INTCLILI;
	public String getINTNACLI() {
		return INTNACLI;
	}
	public void setINTNACLI(String iNTNACLI) {
		INTNACLI = iNTNACLI;
	}
	public String getINTIDELI() {
		return INTIDELI;
	}
	public void setINTIDELI(String iNTIDELI) {
		INTIDELI = iNTIDELI;
	}
	public String getINTMLELI() {
		return INTMLELI;
	}
	public void setINTMLELI(String iNTMLELI) {
		INTMLELI = iNTMLELI;
	}
	public String getINTCLELI() {
		return INTCLELI;
	}
	public void setINTCLELI(String iNTCLELI) {
		INTCLELI = iNTCLELI;
	}
	public String getINTMLILI() {
		return INTMLILI;
	}
	public void setINTMLILI(String iNTMLILI) {
		INTMLILI = iNTMLILI;
	}
	public String getINTCLILI() {
		return INTCLILI;
	}
	public void setINTCLILI(String iNTCLILI) {
		INTCLILI = iNTCLILI;
	}
}
