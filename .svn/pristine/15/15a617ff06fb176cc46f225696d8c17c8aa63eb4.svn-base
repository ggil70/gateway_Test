/**
 * Archivo del Bean para manejar los errores posibles en la ejecución de los servicios
 * 
 * @author Adverweb <http://www.adverweb.com>
 *
 */


/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;


/**
 * 
 *Clase para manejar los errores posibles en la Ejecución de los Servicios
 *
 */
public class WSResponse {
	
	/**
	 * Parámetro para manejar el número de error en la ejecución de los servicios
	 */
	private ELEERR error;
	

	public ELEERR getError() {
		return error;
	}

	public void setError(ELEERR error) {
		this.error = error;
	}
}
