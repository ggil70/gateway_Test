/**
 * Archivo del Bean para la Actualizacion de la sesion del usuario
 * 
 * @author Rosiris Veliz 
 *
 */

/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;


public class ActualizaSesionBean{
    
    private int canal;
    
    private String tipoDocumento;
    
    private String documento;
    
    private String login; 
    
    private int estatus;
    
    private String ip;

    public ActualizaSesionBean() {
    }

    /**
     * Gets the canal value for this ActualizaSesionRequest.
     * 
     * @return canal
     */
    public int getCanal() {
        return canal;
    }


    /**
     * Sets the canal value for this ActualizaSesionRequest.
     * 
     * @param canal
     */
    public void setCanal(int canal) {
        this.canal = canal;
    }


    /**
     * Gets the documento value for this ActualizaSesionRequest.
     * 
     * @return documento
     */
    public String getDocumento() {
        return documento;
    }


    /**
     * Sets the documento value for this ActualizaSesionRequest.
     * 
     * @param documento
     */
    public void setDocumento(String documento) {
        this.documento = documento;
    }


    /**
     * Gets the estatus value for this ActualizaSesionRequest.
     * 
     * @return estatus
     */
    public int getEstatus() {
        return estatus;
    }


    /**
     * Sets the estatus value for this ActualizaSesionRequest.
     * 
     * @param estatus
     */
    public void setEstatus(int estatus) {
        this.estatus = estatus;
    }


    /**
     * Gets the login value for this ActualizaSesionRequest.
     * 
     * @return login
     */
    public String getLogin() {
        return login;
    }


    /**
     * Sets the login value for this ActualizaSesionRequest.
     * 
     * @param login
     */
    public void setLogin(String login) {
        this.login = login;
    }


    /**
     * Gets the tipoDocumento value for this ActualizaSesionRequest.
     * 
     * @return tipoDocumento
     */
    public String getTipoDocumento() {
        return tipoDocumento;
    }


    /**
     * Sets the tipoDocumento value for this ActualizaSesionRequest.
     * 
     * @param tipoDocumento
     */
    public void setTipoDocumento(String tipoDocumento) {
        this.tipoDocumento = tipoDocumento;
    }

    public String getIp() {
        return ip;
    }

    public void setIp(String ip) {
        this.ip = ip;
    }
        
}
