package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar la respuesta de la Validación de un Número de RIF
 *
 */
public class INVALRIFResponse extends WSResponse {
	
	/**
	 * Parámetro para manejar la respuesta de la Validación del Número de RIF
	 */
	private INVALRIFBean INVALRIF;

	public INVALRIFBean getINVALRIF() {
		return INVALRIF;
	}

	public void setINVALRIF(INVALRIFBean iNVALRIF) {
		INVALRIF = iNVALRIF;
	}

}
