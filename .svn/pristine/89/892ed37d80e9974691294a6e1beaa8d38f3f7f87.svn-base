/**
 * Archivo del Bean para manejar el request del Bloqueo por IVR
 * 
 * @author Adverweb <http://www.adverweb.com>
 *
 */


/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;


/**
 * 
 * Clase para manejar los parámetros de entrada del bloqueo por IVR
 *
 */
public class BloqueoIVRBean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el tipo de documento de identificación
	 */
	private String tipoCedula;
	
	/**
	 * Parámetro para manejar el documento de identificación
	 */
	private String cedula;
	
	/**
	 * Parámetro para manejar el estatus del resgistro
	 */
	private String registro;
	
	/**
	 * Parámetro para manejar el estatus de acceso
	 */
	private String acceso;

	
	public String getRegistro() {
		return registro;
	}

	public void setRegistro(String registro) {
		this.registro = registro;
	}

	public String getAcceso() {
		return acceso;
	}

	public void setAcceso(String acceso) {
		this.acceso = acceso;
	}

	public String getTipoCedula() {
		return tipoCedula;
	}

	public void setTipoCedula(String tipoCedula) {
		this.tipoCedula = tipoCedula;
	}

	public String getCedula() {
		return cedula;
	}

	public void setCedula(String cedula) {
		this.cedula = cedula;
	}
	
	

}
