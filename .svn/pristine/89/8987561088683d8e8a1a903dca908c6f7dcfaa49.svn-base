/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar la Consulta de Cash
 *
 */
public class IBPINFDATBean extends ParamsGenerales{
	
    private String IBPUSR;
    private String IBPPID;
    private String IBPVDD;
    private String IBPVDM;
    private String IBPVDY;
    private String IBPNUM;
    private String IBPMTO;
    private String IBPMTE;
    private String IBPMTP;
    private String IBPMTR;
    private String IBPSTS;

    public String getIBPUSR() {
        return IBPUSR;
    }

    public void setIBPUSR(String IBPUSR) {
        this.IBPUSR = IBPUSR;
    }

    public String getIBPPID() {
        return IBPPID;
    }

    public void setIBPPID(String IBPPID) {
        this.IBPPID = IBPPID;
    }

    public String getIBPVDD() {
        return IBPVDD;
    }

    public void setIBPVDD(String IBPVDD) {
        this.IBPVDD = IBPVDD;
    }

    public String getIBPVDM() {
        return IBPVDM;
    }

    public void setIBPVDM(String IBPVDM) {
        this.IBPVDM = IBPVDM;
    }

    public String getIBPVDY() {
        return IBPVDY;
    }

    public void setIBPVDY(String IBPVDY) {
        this.IBPVDY = IBPVDY;
    }

    public String getIBPNUM() {
        return IBPNUM;
    }

    public void setIBPNUM(String IBPNUM) {
        this.IBPNUM = IBPNUM;
    }

    public String getIBPMTO() {
        return IBPMTO;
    }

    public void setIBPMTO(String IBPMTO) {
        this.IBPMTO = IBPMTO;
    }

    public String getIBPMTE() {
        return IBPMTE;
    }

    public void setIBPMTE(String IBPMTE) {
        this.IBPMTE = IBPMTE;
    }

    public String getIBPMTP() {
        return IBPMTP;
    }

    public void setIBPMTP(String IBPMTP) {
        this.IBPMTP = IBPMTP;
    }

    public String getIBPMTR() {
        return IBPMTR;
    }

    public void setIBPMTR(String IBPMTR) {
        this.IBPMTR = IBPMTR;
    }

    public String getIBPSTS() {
        return IBPSTS;
    }

    public void setIBPSTS(String IBPSTS) {
        this.IBPSTS = IBPSTS;
    }
    
}
