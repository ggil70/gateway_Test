/**
 * Contenedor de clases
 * 
 */
package com.activo.gateway.beans;


/**
 * Clase para el manejo de la respuesta con el resultado de la encriptacion
 *
 */
public class Sha1Response extends WSResponse {
	
	/**
	 * Cadena encriptada
	 * 
	 */
	private String encriptado;

	/**
	 * @return the encriptado
	 */
	public String getEncriptado() {
		return encriptado;
	}

	/**
	 * @param the encriptado to set
	 */
	public void setEncriptado(String encriptado) {
		this.encriptado = encriptado;
	}
}
