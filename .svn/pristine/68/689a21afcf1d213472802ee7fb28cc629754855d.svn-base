        }

        public void setINTCANAL6(String INTCANAL6) {
            this.INTCANAL6 = INTCANAL6;
        }

        public String getINTCCY6() {
            return INTCCY6;
        }

        public void setINTCCY6(String INTCCY6) {
            this.INTCCY6 = INTCCY6;
        }

        public String getINTDIP6() {
            return INTDIP6;
        }

        public void setINTDIP6(String INTDIP6) {
            this.INTDIP6 = INTDIP6;
        }

        public String getDescTipoTransaccion() {
            return descTipoTransaccion;
        }

        public void setDescTipoTransaccion(String descTipoTransaccion) {
            this.descTipoTransaccion = descTipoTransaccion;
        }

        public String getDescTipoOperacion() {
