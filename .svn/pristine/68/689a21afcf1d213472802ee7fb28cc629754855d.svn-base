package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar Transferencias Internas
 *
 */
public class INTRFDSJV6Bean extends ParamsGenerales{

	/**
	 * Parámetro para manejar el Usuario
	 */
	private String INTUSR6 ;
	
	/**
	 * Parámetro para manejar el Número de CUenta Origen de la Transacción
	 */
	private String INTFRMACC6 ;
	
	/**
	 * Parámetro para manejar el Número de Cuenta Destino de la Transacción
	 */
	private String INTTOACC6 ;
	
	/**
	 * Parámetro para manejar el Monto de la Transacción
	 */
	private String INTTRFAMT6 ;
	
	/**
	 * Parámetro para manejar el Tipo de Transferencia
	 */
	private String INTTYPE6 ;
	
	/**
	 * Parámetro para manejar el Número de Referencia de la Transacción
	 */
	private String INTREF6 ;
	
	/**
	 * Parámetro para manejar la Descripción de la Transacción
	 */
	private String INTDESC6;
        
        /**
	 * Parámetro para manejar el canal
	 */
	private String INTCANAL6;
        
        /**
	 * Parámetro para manejar la moneda
	 */
	private String INTCCY6;
                
        /**
	 * Parámetro para manejar la IP
	 */
	private String INTDIP6;	                       
	
	//Campos para el envío de correo electrónico.
	
	private String descTipoTransaccion;
	
	private String descTipoOperacion;
	
	private String nombreBeneficiario;
	
	private String concepto;
	
	private String emailBeneficiario;
	
	private String id_usuario;
	
	private String operacion;

        public String getINTUSR6() {
            return INTUSR6;
        }

        public void setINTUSR6(String INTUSR6) {
            this.INTUSR6 = INTUSR6;
        }

        public String getINTFRMACC6() {
            return INTFRMACC6;
        }

        public void setINTFRMACC6(String INTFRMACC6) {
            this.INTFRMACC6 = INTFRMACC6;
        }

        public String getINTTOACC6() {
            return INTTOACC6;
        }

        public void setINTTOACC6(String INTTOACC6) {
            this.INTTOACC6 = INTTOACC6;
        }

        public String getINTTRFAMT6() {
            return INTTRFAMT6;
        }

        public void setINTTRFAMT6(String INTTRFAMT6) {
            this.INTTRFAMT6 = INTTRFAMT6;
        }

        public String getINTTYPE6() {
            return INTTYPE6;
        }

        public void setINTTYPE6(String INTTYPE6) {
            this.INTTYPE6 = INTTYPE6;
        }

        public String getINTREF6() {
            return INTREF6;
        }

        public void setINTREF6(String INTREF6) {
