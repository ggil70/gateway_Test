package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar la Respuesta de las Transferencias Internas y Externas Realizadas
 *
 */
public class TINQDSJVResponse extends WSResponse{

	/**
	 * Parámetro para manejar la Respuesta de la Consulta de las Transferencias Internas y Externas Realizadas
	 */
	private TINQDSJVBean[] TINQDSJV;

	/**
	 * Parámetro para manejar la Respuesta de la Consulta de la Transferencia Interna y Externa Seleccionada
	 */
	private TINQDSJVBean TINQDSJV2;


	public TINQDSJVBean[] getTINQDSJV() {
		return TINQDSJV;
	}

	public void setTINQDSJV(TINQDSJVBean[] tINQDSJV) {
		TINQDSJV = tINQDSJV;
	}

	public TINQDSJVBean getTINQDSJV2() {
		return TINQDSJV2;
	}

	public void setTINQDSJV2(TINQDSJVBean tINQDSJV2) {
		TINQDSJV2 = tINQDSJV2;
	}



}
