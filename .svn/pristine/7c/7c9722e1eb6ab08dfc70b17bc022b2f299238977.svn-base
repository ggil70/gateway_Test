package com.activo.gateway.beans;

/**
 * Bean con información referente a una referencia bancaria
 *
 * Este bean contiene la información referente a una referencia bancaria
 * La información proviene de la tabla B1046BAT.SATCC.SAPF1037 en el AS400
 *
 * @author Rosiris Veliz rveliz@bancoactivo.com
 *
 */
public class ReferenciaBancariaBean extends ParamsGenerales {

	private String numeroProducto;
    private String tipoProducto;
    private String codProducto;
    private String tipoReferencia;
    private String numeroCliente;
    private String dirigidaA;
    private String tipoCliente;
    private String nroIdentificacionCliente;
    
    private String codigoConfirmacion;
