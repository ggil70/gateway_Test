/**
 * Archivo del Bean para la Asignación y/o Cambio de Alias de los Productos
 * 
 * @author Adverweb <http://www.adverweb.com>
 *
 */


/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar la Asignación y/o Cambio de Alias de los Productos
 *
 */
public class NIKDSJVBean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el Usuario
	 */
	private String NIKUSR;
	
	/**
	 * Parámetro para manejar la Descripción del Producto
	 */
	private String NIKDSC;
	private String NIKACC;
	private String NIKCCN;
	
	/**
	 * Parámetro para manejar el Alias
	 */
	private String NIKNNM;
	
	/**
	 * Parámetro para manejar el Tipo de Cuenta
	 */
	private String NIKTYP;
	
	
	public String getNIKUSR() {
		return NIKUSR;
	}
	public void setNIKUSR(String nIKUSR) {
		NIKUSR = nIKUSR;
	}
	public String getNIKDSC() {
		return NIKDSC;
	}
	public void setNIKDSC(String nIKDSC) {
		NIKDSC = nIKDSC;
	}
	public String getNIKACC() {
		return NIKACC;
	}
	public void setNIKACC(String nIKACC) {
		NIKACC = nIKACC;
	}
	public String getNIKCCN() {
		return NIKCCN;
	}
	public void setNIKCCN(String nIKCCN) {
		NIKCCN = nIKCCN;
	}
	public String getNIKNNM() {
		return NIKNNM;
	}
	public void setNIKNNM(String nIKNNM) {
		NIKNNM = nIKNNM;
	}
	public String getNIKTYP() {
		return NIKTYP;
	}
	public void setNIKTYP(String nIKTYP) {
		NIKTYP = nIKTYP;
	}
	
	

}
