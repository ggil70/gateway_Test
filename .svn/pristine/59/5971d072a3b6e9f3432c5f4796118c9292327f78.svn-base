/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar el Cambio de Teléfono Celular
 *
 */
public class NIBPF3040Bean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el TIpo de Identificación del Usuario
	 */
	private String INTNACTC;
	
	/**
	 * Parámetro para manejar el Número de Identificación del Usuario
	 */
	private String INTIDETC;
	
	/**
	 * Parámetro para manejar el Número de Teléfono Celular
	 */
	private String INTNTCTC;
	
	
	public String getINTNACTC() {
		return INTNACTC;
	}
	public void setINTNACTC(String iNTNACTC) {
		INTNACTC = iNTNACTC;
	}
	public String getINTIDETC() {
		return INTIDETC;
	}
	public void setINTIDETC(String iNTIDETC) {
		INTIDETC = iNTIDETC;
	}
	public String getINTNTCTC() {
		return INTNTCTC;
	}
	public void setINTNTCTC(String iNTNTCTC) {
		INTNTCTC = iNTNTCTC;
	}
	
}
