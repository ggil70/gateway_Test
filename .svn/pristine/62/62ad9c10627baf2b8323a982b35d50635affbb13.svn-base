/**
 * Archivo del Bean para el manejo de las Preguntas utilizadas en el Proceso de Autenticación
 * 
 * @author Adverweb <http://www.adverweb.com>
 *
 */


/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar de las Preguntas utilizadas en el Proceso de Autenticación
 *
 */
public class PreguntasBean {
	
	/**
	 * Parámetro para manejar el Código de la Pregunta
	 */
	private String codigo;
	
	/**
	 * Parámetro para manejar el Código de la Pregunta Padre
	 */
	private String codigoPadre;
	
	private String formularioTipo;
	
	private int formularioMaxlength;
	
	/**
	 * Parámetro para manejar la Pregunta de Autenticación
	 */
	private String pregunta;
	
	/**
	 * Parámetro para manejar la Respuesta de la Pregunta de Autenticación
	 */
	private String respuesta;
	
	/**
	 * Parámetro para manejar el Tipo de Repuesta de la Pregunta de Autenticación
	 */
	private String tipoRespuesta;
	
	private String variable;
	
	/**
	 * Parámetro para manejar el Estatus de la Pregunta de Autenticación
	 */
	private String estatus;
	

	public String getEstatus() {
		return estatus;
	}

	public void setEstatus(String estatus) {
		this.estatus = estatus;
	}

	public String getVariable() {
		return variable;
	}

	public void setVariable(String variable) {
		this.variable = variable;
	}

	public String getCodigo() {
		return codigo;
	}

	public void setCodigo(String codigo) {
		this.codigo = codigo;
	}

	public String getPregunta() {
		return pregunta;
	}

	public void setPregunta(String pregunta) {
		this.pregunta = pregunta;
	}

	public String getFormularioTipo() {
		return formularioTipo;
	}

	public void setFormularioTipo(String formularioTipo) {
		this.formularioTipo = formularioTipo;
	}

	public int getFormularioMaxlength() {
		return formularioMaxlength;
	}

	public void setFormularioMaxlength(int formularioMaxlength) {
		this.formularioMaxlength = formularioMaxlength;
	}

	public String getTipoRespuesta() {
		return tipoRespuesta;
	}

	public void setTipoRespuesta(String tipoRespuesta) {
		this.tipoRespuesta = tipoRespuesta;
	}

	public String getCodigoPadre() {
		return codigoPadre;
	}

	public void setCodigoPadre(String codigoPadre) {
		this.codigoPadre = codigoPadre;
	}

	public String getRespuesta() {
		return respuesta;
	}

	public void setRespuesta(String respuesta) {
		this.respuesta = respuesta;
	}

}
