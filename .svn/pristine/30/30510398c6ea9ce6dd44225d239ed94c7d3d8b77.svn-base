package com.activo.gateway.beans;


/**
 * Clase para el manejo de las Afiliaciones de un Usuario
 * @author Adverweb
 *
 */
public class AfiliacionesResponse extends WSResponse{

	/**
	 * Arreglo con las afiliaciones del usuario
	 */
	private Afiliaciones[] afiliaciones;
	

	/**
	 * Retorna las afiliaciones del usuario
	 * @return
	 */
	public Afiliaciones[] getAfiliaciones() {
		return afiliaciones;
	}

	/**
	 * Asigna las afiliaciones del usuario
	 * @param afiliaciones
	 */
	public void setAfiliaciones(Afiliaciones[] afiliaciones) {
		this.afiliaciones = afiliaciones;
	}

}
