 * Archivo para la solicitud de encriptación
 * 
 * @author Adverweb <http://www.adverweb.com>
 *
 */

/**
 * Contenedor de clases
 * 
 */
package com.activo.gateway.beans;


/**
 * Clase para el manejo de la solicitud de encriptación
 * 
 */
public class Sha1Bean {

	/**
	 * Cadena de texto a encriptar
	 * 
	 */
	private String texto;
	
	/**
	 * Indica si utiliza el formato de caracteres para la encriptacion por default o el modificado
	 *  
	 */
	private boolean modificado;

	/**
	 * @return the texto
	 */
	public String getTexto() {
		return texto;
	}

	/**
	 * @param the texto to set
	 */
	public void setTexto(String texto) {
		this.texto = texto;
	}

	/**
	 * @return the modificado
	 */
	public boolean isModificado() {
		return modificado;
	}

	/**
	 * @param modificado the modificado to set
	 */
	public void setModificado(boolean modificado) {
		this.modificado = modificado;
	}

	

}