package com.activo.gateway.interfaces;

import java.util.List;

import com.activo.gateway.beans.ReferenciaBancariaBean;


/**
 * Interfaz que especifica los metodos a implementar por los repoitorios de información de referencias bancarias
 * 
 * @author Rosiris Veliz
 *
 */
public interface IReferenciaBancaria {

	/**
     * Solicita los datos de la referencia bancaria 
     * Dado un request, devuelve los datos necesarios para generar la referencia
     * @param req
     * @return ReferenciaBancariaBean
     * @throws Exception
     */
    ReferenciaBancariaBean getDatosReferencia(ReferenciaBancariaBean req) throws Exception;

}
