/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
  
 *
 */
public class APEDSCASHEBean extends ParamsGenerales{
	
	
	private String APEUSRE;
	private String APEACCS;
	private String APERESP;
	
	public String getAPEUSRE() {
		return APEUSRE;
	}
	public void setAPEUSRE(String aPEUSRE) {
		APEUSRE = aPEUSRE;
	}
	public String getAPEACCS() {
		return APEACCS;
	}
	public void setAPEACCS(String aPEACCS) {
		APEACCS = aPEACCS;
	}
	public String getAPERESP() {
		return APERESP;
	}
	public void setAPERESP(String aPERESP) {
		APERESP = aPERESP;
	}
	
}
