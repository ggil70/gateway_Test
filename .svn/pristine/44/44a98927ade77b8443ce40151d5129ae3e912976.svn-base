/**
 * Archivo del Bean para la respuesta con el listado de los sellos
 * 
 * @author Adverweb <http://www.adverweb.com>
 *
 */


/**
 * Contenedor de clases
 * 
 */
package com.activo.gateway.beans;

/**
 * Clase para el manejo de la respuesta con el listado de los sellos
 *
 */
public class SellosResponse extends WSResponse {

	/**
	 * Arreglo con el listado de los sellos
	 */
	private Sello[] sellos;

	
	/**
	 * Retorna el listado de los sellos
	 * 
	 * @return sellos
	 */
	public Sello[] getSellos() {
		return sellos;
	}

	/**
	 * Asigna el listado de los sellos
	 * 
	 * @param sellos
	 */
	public void setSellos(Sello[] sellos) {
		this.sellos = sellos;
	}
	
}
