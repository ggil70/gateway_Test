/**
 * Archivo del Bean para manejar el proceso de Auditores Externos
 * 
 * @author Adverweb <http://www.adverweb.com>
 *
 */


/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar el proceso de Auditoría Extena  
 *
 */
public class NIB2090PFBean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el usuario web de Internet Banking
	 */
	private String AUDUSR;
	
	/**
	 * Parámetro para manejar la opción que se desea realizar con el servicio
	 */
	private String AUDOPC;
	
	/**
	 * Parámetro para menejar el número de identificación del usuario
	 */
	private String AUDIDN;
	
	/**
	 * Parámetro para manejar el cliente
	 */
	private String AUDCUN;
	
	/**
	 * Parémetro para manejar el nombre del usuario
	 */
	private String AUDNAM;

    /**
     * Parámetro para el manejo del código de la empresa
     */
	private String AUDEMP;
    
    /**
     * Parámetro para el manejo del nombre de la empresa
     */
    private String AUDNEM;

    /**
     * Mensaje para el manejo del canal que consume el servicio, IB = Internet Banking, IN= Intranet, Oficinas Comerciales
     */
    private String AUDCAN;
    
    /**
     * Parámetro para manejar el código de la campaña
     */
    private String AUDCAM;
    
    /**
     * Parámetro para el manejo de los mensajes de error del servicio
     */
    private String AUDERR;
    
    /**
     * Parámetro para el manejo del código de error
     */
    private String AUDCDE;

    /**
     * Parámetro para el manejo de la IP
     */
    private String AUDIPE;
   

	/**
	 * @return the aUDUSR
	 */
	public String getAUDUSR() {
		return AUDUSR;
	}

	/**
	 * @param aUDUSR the aUDUSR to set
	 */
	public void setAUDUSR(String aUDUSR) {
		AUDUSR = aUDUSR;
	}

	/**
	 * @return the aUDOPC
	 */
	public String getAUDOPC() {
		return AUDOPC;
	}

	/**
	 * @param aUDOPC the aUDOPC to set
	 */
	public void setAUDOPC(String aUDOPC) {
		AUDOPC = aUDOPC;
	}

	/**
	 * @return the aUDIDN
	 */
	public String getAUDIDN() {
		return AUDIDN;
	}

	/**
	 * @param aUDIDN the aUDIDN to set
	 */
	public void setAUDIDN(String aUDIDN) {
		AUDIDN = aUDIDN;
	}

	/**
	 * @return the aUDCUN
	 */
	public String getAUDCUN() {
		return AUDCUN;
	}

	/**
	 * @param aUDCUN the aUDCUN to set
	 */
	public void setAUDCUN(String aUDCUN) {
		AUDCUN = aUDCUN;
	}

	/**
	 * @return the aUDNAM
	 */
	public String getAUDNAM() {
		return AUDNAM;
	}

	/**
	 * @param aUDNAM the aUDNAM to set
	 */
	public void setAUDNAM(String aUDNAM) {
		AUDNAM = aUDNAM;
	}

	/**
	 * @return the aUDEMP
	 */
	public String getAUDEMP() {
		return AUDEMP;
	}

	/**
	 * @param aUDEMP the aUDEMP to set
	 */
	public void setAUDEMP(String aUDEMP) {
		AUDEMP = aUDEMP;
	}

	/**
	 * @return the aUDNEM
	 */
	public String getAUDNEM() {
		return AUDNEM;
	}

	/**
	 * @param aUDNEM the aUDNEM to set
	 */
	public void setAUDNEM(String aUDNEM) {
		AUDNEM = aUDNEM;
	}

	/**
	 * @return the aUDCAN
	 */
	public String getAUDCAN() {
		return AUDCAN;
	}

	/**
	 * @param aUDCAN the aUDCAN to set
	 */
	public void setAUDCAN(String aUDCAN) {
		AUDCAN = aUDCAN;
	}

	/**
	 * @return the aUDCAM
	 */
	public String getAUDCAM() {
		return AUDCAM;
	}

	/**
	 * @param aUDCAM the aUDCAM to set
	 */
	public void setAUDCAM(String aUDCAM) {
		AUDCAM = aUDCAM;
	}

	/**
	 * @return the aUDERR
	 */
	public String getAUDERR() {
		return AUDERR;
	}

	/**
	 * @param aUDERR the aUDERR to set
	 */
	public void setAUDERR(String aUDERR) {
		AUDERR = aUDERR;
	}

	/**
	 * @return the aUDCDE
	 */
	public String getAUDCDE() {
		return AUDCDE;
	}

	/**
	 * @param aUDCDE the aUDCDE to set
	 */
	public void setAUDCDE(String aUDCDE) {
		AUDCDE = aUDCDE;
	}

	/**
	 * @return the aUDIPE
	 */
	public String getAUDIPE() {
		return AUDIPE;
	}

	/**
	 * @param aUDIPE the aUDIPE to set
	 */
	public void setAUDIPE(String aUDIPE) {
		AUDIPE = aUDIPE;
	}

}
