/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para hacer login en el IB Anterior
 *
 */
public class PWDDSJVBean {
	
	/**
	 * Parámetro para manejar el Usuario
	 */
	private String PWDUSR;
	
	/**
	 * Parámetro para manejar el Password
	 */
	private String PWDPWD;
	
	/**
	 * Parámetro para manejar el Nuevo Password de Usuario
	 */
	private String PWDNPW;
	
	/**
	 * Parámetro para manejar la Confirmación del Password
	 */
	private String PWDCPW;
	private String PWDNCH;
	
	/**
	 * Parámetro para manejar el Estatus del Registro
	 */
	private String PWDSTS;
	private String PWDOPR;
	
	/**
	 * Parámetro para manejar el Tipo de Confirmación
	 */
	private String PWDCFM;
	private String PWDTRA;
	private String PWDBPA;
	private String PWDLCA;
	private String PWDLNP;
	private String PWDCCP;
	private String PWDMAX;
	private String PWDDTF;
	private String PWDLGT;
	private String PWDCMP;
	private String PWDACL;
	private String PWDINC;
	private String PWDBUC;
	private String PWDGEC;
	private String PWDIAD;
	
	
	public String getPWDUSR() {
		return PWDUSR;
	}
	public void setPWDUSR(String pWDUSR) {
		PWDUSR = pWDUSR;
	}
	public String getPWDPWD() {
		return PWDPWD;
	}
	public void setPWDPWD(String pWDPWD) {
		PWDPWD = pWDPWD;
	}
	public String getPWDNPW() {
		return PWDNPW;
	}
	public void setPWDNPW(String pWDNPW) {
		PWDNPW = pWDNPW;
	}
	public String getPWDCPW() {
		return PWDCPW;
	}
	public void setPWDCPW(String pWDCPW) {
		PWDCPW = pWDCPW;
	}
	public String getPWDNCH() {
		return PWDNCH;
	}
	public void setPWDNCH(String pWDNCH) {
		PWDNCH = pWDNCH;
	}
	public String getPWDSTS() {
		return PWDSTS;
	}
	public void setPWDSTS(String pWDSTS) {
		PWDSTS = pWDSTS;
	}
	public String getPWDOPR() {
		return PWDOPR;
	}
	public void setPWDOPR(String pWDOPR) {
		PWDOPR = pWDOPR;
	}
	public String getPWDCFM() {
		return PWDCFM;
	}
	public void setPWDCFM(String pWDCFM) {
		PWDCFM = pWDCFM;
	}
	public String getPWDTRA() {
		return PWDTRA;
	}
	public void setPWDTRA(String pWDTRA) {
		PWDTRA = pWDTRA;
	}
	public String getPWDBPA() {
		return PWDBPA;
	}
	public void setPWDBPA(String pWDBPA) {
		PWDBPA = pWDBPA;
	}
	public String getPWDLCA() {
		return PWDLCA;
	}
	public void setPWDLCA(String pWDLCA) {
		PWDLCA = pWDLCA;
	}
	public String getPWDLNP() {
		return PWDLNP;
	}
	public void setPWDLNP(String pWDLNP) {
		PWDLNP = pWDLNP;
	}
	public String getPWDCCP() {
		return PWDCCP;
	}
	public void setPWDCCP(String pWDCCP) {
		PWDCCP = pWDCCP;
	}
	public String getPWDMAX() {
		return PWDMAX;
	}
	public void setPWDMAX(String pWDMAX) {
		PWDMAX = pWDMAX;
	}
	public String getPWDDTF() {
		return PWDDTF;
	}
	public void setPWDDTF(String pWDDTF) {
		PWDDTF = pWDDTF;
	}
	public String getPWDLGT() {
		return PWDLGT;
	}
	public void setPWDLGT(String pWDLGT) {
		PWDLGT = pWDLGT;
	}
	public String getPWDCMP() {
		return PWDCMP;
	}
	public void setPWDCMP(String pWDCMP) {
		PWDCMP = pWDCMP;
	}
	public String getPWDACL() {
		return PWDACL;
	}
	public void setPWDACL(String pWDACL) {
		PWDACL = pWDACL;
	}
	public String getPWDINC() {
		return PWDINC;
	}
	public void setPWDINC(String pWDINC) {
		PWDINC = pWDINC;
	}
	public String getPWDBUC() {
		return PWDBUC;
	}
	public void setPWDBUC(String pWDBUC) {
		PWDBUC = pWDBUC;
	}
	public String getPWDGEC() {
		return PWDGEC;
	}
	public void setPWDGEC(String pWDGEC) {
		PWDGEC = pWDGEC;
	}
	public String getPWDIAD() {
