package com.activo.gateway.beans;

/**
 * 
 * Clase para manejar el response del Resumen de Inversiones o Depósitos a Plazo
 *
 */
public class CDSDSJVResponse extends WSResponse{

	/**
	 * Parámetro para manejar la información de la Inversión o Depósito a Plazo
	 */
	private CDSDSJVBean CDSDSJS;

	public CDSDSJVBean getCDSDSJS() {
		return CDSDSJS;
	}

	public void setCDSDSJS(CDSDSJVBean cDSDSJS) {
		CDSDSJS = cDSDSJS;
	}
	
}
