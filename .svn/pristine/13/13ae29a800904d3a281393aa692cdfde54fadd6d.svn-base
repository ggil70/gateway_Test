    private void jButton1ActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_jButton1ActionPerformed
        // TODO add your handling code here:
        
     byte Parte1_bytes[] = Convert.fromHexDataToBinData(uno.toString().getBytes());
     byte Parte3_bytes[] = Convert.fromHexDataToBinData(uno2.toString().getBytes());    
  
     byte Parte_bytes[] = new byte[8];
        for(int k = 0; k < 8; k++)
            Parte_bytes[k] = (byte)(Parte1_bytes[k] ^ Parte3_bytes[k]);

     String XorT = new String(Convert.fromBinDataToHexData(Parte_bytes));
     
     byte Parte2_bytes[] = Convert.fromHexDataToBinData(dos.toString().getBytes());
     byte Parte4_bytes[] = Convert.fromHexDataToBinData(dos2.toString().getBytes());

     byte Parte_bytes2[] = new byte[8];
        for(int k = 0; k < 8; k++)
            Parte_bytes2[k] = (byte)(Parte2_bytes[k] ^ Parte4_bytes[k]);

     String XorT2 = new String(Convert.fromBinDataToHexData(Parte_bytes2)); 
     
     JOptionPane.showMessageDialog(null, XorT + XorT2  +  " "
              + "cd : "  + Utils.tripledesEncrypt ( ceros, 
                  new Block(XorT), new Block(XorT2), 
                  new Block(XorT)).toString().substring(0,4));
     
     try {

      // Check if the pair of keys are present else generate those.
      if (!areKeysPresent()) {
        // Method generates a pair of keys using the RSA algorithm and stores it
        // in their respective files
        generateKey();
      }

      final String originalText = XorT + XorT2;
      ObjectInputStream inputStream = null;

      // Encrypt the string using the public key
      inputStream = new ObjectInputStream(new FileInputStream(PUBLIC_KEY_FILE));
      final PublicKey publicKey = (PublicKey) inputStream.readObject();
      final byte[] cipherText = encrypt(originalText, publicKey);

      File testfile = new File("clave.key");
         try (ObjectOutputStream testfile2 = new ObjectOutputStream(
                  new FileOutputStream(testfile))) {
             testfile2.writeObject(cipherText);
         }



      // Decrypt the cipher text using the private key.
      inputStream = new ObjectInputStream(new FileInputStream(PRIVATE_KEY_FILE));
      final PrivateKey privateKey = (PrivateKey) inputStream.readObject();
      final String plainText = decrypt(cipherText, privateKey);

      // Printing the Original, Encrypted and Decrypted Text
      System.out.println("Original Text: " + originalText);
      System.out.println("Encrypted Text: " + new String(cipherText));
      System.out.println("Decrypted Text: " + plainText);



    } catch (IOException | ClassNotFoundException e) {
    }
    
     
     
     
     
     
    }//GEN-LAST:event_jButton1ActionPerformed

