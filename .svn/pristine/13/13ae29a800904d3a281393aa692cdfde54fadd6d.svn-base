     uno = new Block(x1);   
     x1 = jPasswordField2.getText();
     dos = new Block(x1);   
     jTextField1.setText(Utils.tripledesEncrypt ( ceros, 
                  uno, dos, uno).toString().substring(0,4));
      jPasswordField3.requestFocus();
        
    }//GEN-LAST:event_jTextField1FocusGained

