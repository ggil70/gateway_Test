package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar la Respuesta de los Movimientos de Tarjetas de Crédito
 *
 */
public class CCARDTRJVResponse extends WSResponse {
	
	/**
	 * Parámetro para manejar la Respuesta de la Consulta de los Movimientos de Tarjetas de Crédito
	 */
	private CCARDTRJVBean[] CCARDTRJV;

	/**
	 * Parámetro para manejar la Respuesta de la Consulta del Movimiento Seleccionado de la Tarjeta de Crédito 
	 */
	private CCARDTRJVBean CCARDTRJV2;
	
	public CCARDTRJVBean getCCARDTRJV2() {
		return CCARDTRJV2;
	}

	public void setCCARDTRJV2(CCARDTRJVBean cCARDTRJV2) {
		CCARDTRJV2 = cCARDTRJV2;
	}

	public CCARDTRJVBean[] getCCARDTRJV() {
		return CCARDTRJV;
	}

	public void setCCARDTRJV(CCARDTRJVBean[] cCARDTRJV) {
		CCARDTRJV = cCARDTRJV;
	}

	

}
