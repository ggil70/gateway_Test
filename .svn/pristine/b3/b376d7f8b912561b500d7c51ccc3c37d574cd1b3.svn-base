/**
 * Archivo del Bean para manejar el request de la Autenticación del Usuario
 * 
 * @author Adverweb <http://www.adverweb.com>
 *
 */


/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;


/**
 * Clase para manejar los parámetros de entrada de la Autenticación del Usuario
 *
 */
public class AutenticarIVRBean extends ParamsGenerales {
	
        /**
	 * Parámetro para el manejo del número de documento de identificación
	 */
	private String ip;
        
	/**
	 * Parámetro para el manejo del tipo de documento de identificación
	 */
	private String tipoDocumento;
	
	/**
	 * Parámetro para el manejo del número de documento de identificación
	 */
	private String numeroDocumento;
	
        /**
	 * Parámetro para el manejo del login
	 */
	private String login;
	
	/**
	 * Parámetro para el manejo de la ip de conexion
	 */
	private String claveIVR;

        public String getIp() {
            return ip;
        }

        public void setIp(String ip) {
            this.ip = ip;
        }
        

	public String getTipoDocumento() {
		return tipoDocumento;
	}

	public void setTipoDocumento(String tipoDocumento) {
		this.tipoDocumento = tipoDocumento;
	}

	public String getNumeroDocumento() {
		return numeroDocumento;
	}

	public void setNumeroDocumento(String numeroDocumento) {
		this.numeroDocumento = numeroDocumento;
	}

        public String getLogin() {
            return login;
        }

        public void setLogin(String login) {
            this.login = login;
        }

	public String getClaveIVR() {
		return claveIVR;
	}

	public void setClaveIVR(String claveIVR) {
		this.claveIVR = claveIVR;
	}	
	
}
