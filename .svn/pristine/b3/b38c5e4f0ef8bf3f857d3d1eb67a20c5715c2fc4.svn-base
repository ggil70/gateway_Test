/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar el Ingreso de Usuarios en el Archivo EUSER
 *
 */
public class NIBPF3020Bean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el Tipo de Identificación del Usuario
	 */
	private String INTNACEU;
	
	/**
	 * Parámetro para manejar el Número de Identificación del Usuario
	 */
	private String INTIDEEU;
	
	
	public String getINTNACEU() {
		return INTNACEU;
	}
	public void setINTNACEU(String iNTNACEU) {
		INTNACEU = iNTNACEU;
	}
	public String getINTIDEEU() {
		return INTIDEEU;
	}
	public void setINTIDEEU(String iNTIDEEU) {
		INTIDEEU = iNTIDEEU;
	}

}
