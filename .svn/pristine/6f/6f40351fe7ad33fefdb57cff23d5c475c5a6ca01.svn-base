package com.activo.gateway.beans;
public class CelupagosRequest extends ParamsGenerales{
    private String telefono;
    private String compania;               //Inter 2 - Digitel 1
    private String producto;               //Fijo 1 - movil 2
    private String servicio;               //Prepago 1 - Postpago 2
    private String codarea;
    private String ip;
    private String nrodocumento;
    private String nrocontrato;
    private String ope;
    private String referenciaD;
    private String referenciaB;
    private Double monto;
    private String cuentadebito;
    private String reverso;
    private String refreverso;
    

    public String getTelefono() {
        return telefono;
    }

    public void setTelefono(String telefono) {
        this.telefono = telefono;
    }

    public String getProducto() {
        return producto;
    }

    public void setProducto(String producto) {
        this.producto = producto;
    }

    public String getServicio() {
        return servicio;
    }

    public void setServicio(String servicio) {
        this.servicio = servicio;
    }

    public String getCodarea() {
        return codarea;
    }

    public void setCodarea(String codarea) {
        this.codarea = codarea;
    }

    public String getIp() {
        return ip;
    }

    public void setIp(String ip) {
        this.ip = ip;
    }

    public String getCompania() {
        return compania;
    }

    public void setCompania(String compania) {
        this.compania = compania;
    }

    public String getNrodocumento() {
        return nrodocumento;
    }

    public void setNrodocumento(String nrodocumento) {
        this.nrodocumento = nrodocumento;
    }

    public String getNrocontrato() {
        return nrocontrato;
    }

    public void setNrocontrato(String nrocontrato) {
        this.nrocontrato = nrocontrato;
    }

    public String getOpe() {
        return ope;
    }

    public void setOpe(String ope) {
        this.ope = ope;
    }

    public String getReferenciaD() {
        return referenciaD;
    }

    public void setReferenciaD(String referenciaD) {
        this.referenciaD = referenciaD;
    }

    public String getReferenciaB() {
        return referenciaB;
    }

    public void setReferenciaB(String referenciaB) {
        this.referenciaB = referenciaB;
    }

    public Double getMonto() {
        return monto;
    }

    public void setMonto(Double monto) {
        this.monto = monto;
    }

    public String getCuentadebito() {
        return cuentadebito;
    }

    public void setCuentadebito(String cuentadebito) {
        this.cuentadebito = cuentadebito;
    }

    public String getReverso() {
        return reverso;
    }

    public void setReverso(String reverso) {
        this.reverso = reverso;
    }

    public String getRefreverso() {
        return refreverso;
    }

    public void setRefreverso(String refreverso) {
        this.refreverso = refreverso;
    }
}
