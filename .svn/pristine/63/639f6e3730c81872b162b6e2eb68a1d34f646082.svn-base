/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar las Preguntas de Autenticación
 *
 */
public class PreguntasAutenticacionResponse extends WSResponse{
	
	/**
	 * Parámetro para manejar as Preguntas de Autenticación
	 */
	private PreguntasBean[] preguntas;

	public PreguntasBean[] getPreguntas() {
		return preguntas;
	}

	public void setPreguntas(PreguntasBean[] preguntas) {
		this.preguntas = preguntas;
	}
	
}
