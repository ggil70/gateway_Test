/*
 * Bean con información referente a los dias feriados
 *
 * Este bean contiene la informacion referente a los dias feriados por a�o.
 * La información proviene de la tabla ACPCYFILES.holyd en el AS400
 *
 * @author Marcel Guglielmelli mguglielmelli@bancoactivo.com
 */
package com.activo.gateway.beans;

public class ConsultaFeriadosBean extends ParamsGenerales {
    
    private String dia;
    private String mes;
    private String ano; 
    
    public ConsultaFeriadosBean() {
		
	}

    public String getDia() {
        return dia;
    }

    public void setDia(String dia) {
        this.dia = dia;
    }

    public String getMes() {
        return mes;
    }

    public void setMes(String mes) {
        this.mes = mes;
    }

    public String getAno() {
        return ano;
    }

    public void setAno(String ano) {
        this.ano = ano;
    }
        
}
