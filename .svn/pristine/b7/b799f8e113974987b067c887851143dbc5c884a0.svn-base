/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar la Solicitud de Estado de Cuenta, Consulta de Movimientos
 *
 */
public class STMRDSJVBean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el Usuario
	 */
	private String RSTUSR;
	
	/**
	 * Parámetro para manejar el Número de Cuenta
	 */
	private String RSTACC;
	
	/**
	 * Parámetro para manejar la Bandera para el Listado de Transacciones
	 */
	private String RSTCAF;
	
	/**
	 * Parámetro para manejar la Fecha Desde, Día
	 */
	private String RSTFD1;
	
	/**
	 * Parámetro para manejar la Fecha Desde, Mes
	 */
	private String RSTFD2;
	
	/**
	 * Parámetro para manejar la Fecha Desde, Año
	 */
	private String RSTFD3;
	
	/**
	 * Parámetro para manejar la Fecha Hasta, Día
	 */
	private String RSTTD1;
	
	/**
	 * Parámetro para manejar la Fecha Hasta, Mes
	 */
	private String RSTTD2;
	
	/**
	 * Parámetro para manejar la Fecha Hasta, Año
	 */
	private String RSTTD3;
	
	/**
	 * Parámetro para manejar el Número de Cheque Desde
	 */
	private String RSTFCK;
	
	/**
	 * Parámetro para manejar el Número de Cheque Hasta
	 */
	private String RSTTCK;
	
	/**
	 * Parámetro para manejar el Monto Desde
	 */
	private String RSTFAM;
	
	/**
	 * Parámetro para manejar el Monto Hasta
	 */
	private String RSTTAM;
	
	/**
	 * Parámetro para manejar el Registro Desde
	 */
	private String RSTFRC;
	
	/**
	 * Parámetro para manejar el Registro Balance
	 */
	private String RSTFBL;
	
	
	public String getRSTUSR() {
		return RSTUSR;
	}
	public void setRSTUSR(String rSTUSR) {
		RSTUSR = rSTUSR;
	}
	public String getRSTACC() {
		return RSTACC;
	}
	public void setRSTACC(String rSTACC) {
		RSTACC = rSTACC;
	}
	public String getRSTCAF() {
		return RSTCAF;
	}
	public void setRSTCAF(String rSTCAF) {
		RSTCAF = rSTCAF;
	}
	public String getRSTFD1() {
		return RSTFD1;
	}
	public void setRSTFD1(String rSTFD1) {
		RSTFD1 = rSTFD1;
	}
	public String getRSTFD2() {
		return RSTFD2;
	}
	public void setRSTFD2(String rSTFD2) {
		RSTFD2 = rSTFD2;
	}
	public String getRSTFD3() {
		return RSTFD3;
	}
	public void setRSTFD3(String rSTFD3) {
		RSTFD3 = rSTFD3;
	}
	public String getRSTTD1() {
		return RSTTD1;
	}
	public void setRSTTD1(String rSTTD1) {
		RSTTD1 = rSTTD1;
	}
	public String getRSTTD2() {
		return RSTTD2;
	}
	public void setRSTTD2(String rSTTD2) {
		RSTTD2 = rSTTD2;
	}
	public String getRSTTD3() {
		return RSTTD3;
	}
	public void setRSTTD3(String rSTTD3) {
		RSTTD3 = rSTTD3;
	}
	public String getRSTFCK() {
		return RSTFCK;
	}
	public void setRSTFCK(String rSTFCK) {
		RSTFCK = rSTFCK;
	}
	public String getRSTTCK() {
		return RSTTCK;
	}
	public void setRSTTCK(String rSTTCK) {
		RSTTCK = rSTTCK;
	}
	public String getRSTFAM() {
		return RSTFAM;
	}
	public void setRSTFAM(String rSTFAM) {
		RSTFAM = rSTFAM;
	}
	public String getRSTTAM() {
		return RSTTAM;
	}
	public void setRSTTAM(String rSTTAM) {
		RSTTAM = rSTTAM;
	}
	public String getRSTFRC() {
		return RSTFRC;
	}
	public void setRSTFRC(String rSTFRC) {
		RSTFRC = rSTFRC;
	}
	public String getRSTFBL() {
		return RSTFBL;
	}
	public void setRSTFBL(String rSTFBL) {
		RSTFBL = rSTFBL;
	}
}
