/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar Transferencias Internas
 *
 */
public class INTRFDSJVBean extends ParamsGenerales{

	/**
	 * Parámetro para manejar el Usuario
	 */
	private String INTUSR ;
	
	/**
	 * Parámetro para manejar el Número de CUenta Origen de la Transacción
	 */
	private String INTFRMACC ;
	
	/**
	 * Parámetro para manejar el Número de Cuenta Destino de la Transacción
	 */
	private String INTTOACC ;
	
	/**
	 * Parámetro para manejar el Monto de la Transacción
	 */
	private String INTTRFAMT ;
	
	/**
	 * Parámetro para manejar el Tipo de Transferencia
	 */
	private String INTTYPE ;
	
	/**
	 * Parámetro para manejar el Número de Referencia de la Transacción
	 */
	private String INTREF ;
	
	/**
	 * Parámetro para manejar la Descripción de la Transacción
	 */
	private String INTDESC;
	
        /**
	 * Parámetro para manejar la IP
	 */
	private String INTIPACT;
	
	//Campos para el envío de correo electrónico.
	
	private String descTipoTransaccion;
	
	private String descTipoOperacion;
	
	private String nombreBeneficiario;
	
	private String concepto;
	
	private String emailBeneficiario;
	
	private String id_usuario;
	
	private String operacion;
	
	private String INTUSER;
        
        private String INTPASWD;
        
	public String getINTUSR() {
		return INTUSR;
	}
	public void setINTUSR(String iNTUSR) {
		INTUSR = iNTUSR;
	}
	public String getINTFRMACC() {
		return INTFRMACC;
	}
	public void setINTFRMACC(String iNTFRMACC) {
		INTFRMACC = iNTFRMACC;
	}
	public String getINTTYPE() {
		return INTTYPE;
	}
	public void setINTTYPE(String iNTTYPE) {
		INTTYPE = iNTTYPE;
	}
	public String getINTREF() {
		return INTREF;
	}
	public void setINTREF(String iNTREF) {
		INTREF = iNTREF;
	}
	public String getINTDESC() {
		return INTDESC;
	}
	public void setINTDESC(String iNTDESC) {
		INTDESC = iNTDESC;
	}
	public String getINTTOACC() {
		return INTTOACC;
	}
	public void setINTTOACC(String iNTTOACC) {
		INTTOACC = iNTTOACC;
	}
	public String getINTTRFAMT() {
		return INTTRFAMT;
	}
	public void setINTTRFAMT(String iNTTRFAMT) {
		INTTRFAMT = iNTTRFAMT;
	}

	/**
	 * @return the nombreBeneficiario
	 */
	public String getNombreBeneficiario() {
		return nombreBeneficiario;
	}
	/**
	 * @param nombreBeneficiario the nombreBeneficiario to set
	 */
	public void setNombreBeneficiario(String nombreBeneficiario) {
		this.nombreBeneficiario = nombreBeneficiario;
	}
	/**
	 * @return the concepto
	 */
	public String getConcepto() {
		return concepto;
	}
	/**
	 * @param concepto the concepto to set
	 */
	public void setConcepto(String concepto) {
		this.concepto = concepto;
	}
	/**
	 * @return the emailBeneficiario
	 */
	public String getEmailBeneficiario() {
		return emailBeneficiario;
	}
	/**
	 * @param emailBeneficiario the emailBeneficiario to set
	 */
	public void setEmailBeneficiario(String emailBeneficiario) {
		this.emailBeneficiario = emailBeneficiario;
	}
	/**
	 * @return the id_usuario
	 */
	public String getId_usuario() {
		return id_usuario;
	}
	/**
	 * @param id_usuario the id_usuario to set
	 */
	public void setId_usuario(String id_usuario) {
		this.id_usuario = id_usuario;
	}
	/**
	 * @return the descTipoTransaccion
	 */
	public String getDescTipoTransaccion() {
		return descTipoTransaccion;
	}
	/**
	 * @param descTipoTransaccion the descTipoTransaccion to set
	 */
	public void setDescTipoTransaccion(String descTipoTransaccion) {
		this.descTipoTransaccion = descTipoTransaccion;
	}
	/**
	 * @return the descTipoOperacion
	 */
	public String getDescTipoOperacion() {
		return descTipoOperacion;
	}
	/**
	 * @param descTipoOperacion the descTipoOperacion to set
	 */
	public void setDescTipoOperacion(String descTipoOperacion) {
		this.descTipoOperacion = descTipoOperacion;
	}
	/**
	 * @return the operacion
	 */
	public String getOperacion() {
		return operacion;
	}
	/**
	 * @param operacion the operacion to set
	 */
	public void setOperacion(String operacion) {
		this.operacion = operacion;
	}

        public String getINTIPACT() {
            return INTIPACT;
        }

        public void setINTIPACT(String INTIPACT) {
            this.INTIPACT = INTIPACT;
        }

        public String getINTUSER() {
            return INTUSER;
        }

        public void setINTUSER(String INTUSER) {
            this.INTUSER = INTUSER;
        }

        public String getINTPASWD() {
            return INTPASWD;
        }

        public void setINTPASWD(String INTPASWD) {
            this.INTPASWD = INTPASWD;
        }        
}
