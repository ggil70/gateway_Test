package com.activo.gateway.beans;

public class INVALTDCBean {
	
	private String RUSUARIO;
	private String RNROTARJ;
	private String RNROCTA;
	private String RCEDRIF;
	
	public String getRCEDRIF() {
		return RCEDRIF;
	}
	public void setRCEDRIF(String rCEDRIF) {
		RCEDRIF = rCEDRIF;
	}
	public String getRUSUARIO() {
		return RUSUARIO;
	}
	public void setRUSUARIO(String rUSUARIO) {
		RUSUARIO = rUSUARIO;
	}
	public String getRNROTARJ() {
		return RNROTARJ;
	}
	public void setRNROTARJ(String rNROTARJ) {
		RNROTARJ = rNROTARJ;
	}
	public String getRNROCTA() {
		return RNROCTA;
	}
	public void setRNROCTA(String rNROCTA) {
		RNROCTA = rNROCTA;
	}
}
