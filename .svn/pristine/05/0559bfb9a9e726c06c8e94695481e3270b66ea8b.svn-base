/**
 * Contenedor de clases
 */
package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar el Resumen de Productos
 *
 */
public class SUMDSJVBean extends ParamsGenerales{
	
	/**
	 * Parámetro para manejar el Usuario
	 */
	private String SUMUSR;
	
	/**
	 * Parámetro para la Bandera para manejar los Activos y Pasivos
	 */
	private String SUMFLG;
	
	/**
	 * Parámetro para manejar el Tipo de Cuenta
	 */
	private String SUMTYP;
	
	/**
	 * Parámetro para manejar la Descripción de la Transacción
	 */
	private String SUMDSC;
	
	/**
	 * Parámetro para manejar el Número de Cuenta
	 */
	private String SUMACN;
	
	/**
	 * Parámetro para manejar el Saldo de la Cuenta
	 */
	private String SUMBAL;
	
	/**
	 * Parámetro para manejar el Saldo Disponible
	 */
	private String SUMAVB;
	
	/**
	 * Parámetro para manejar la Moneda
	 */
	private String SUMCCY;
	
	/**
	 * Parámetro para manejar el Alias del Producto
	 */
	private String SUMNNM;
	
	/**
	 * Parámetro para manejar el Tipo de Firma
	 */
	private String SUMFIR;
	
	
	/**
	 * Parámetro para manejar el alias recuperado de la base de datos
	 */
	private String SUMNEM;
	
	/**
	 * Parámetro para manejar el estatus de las cuentas
	 */
	private String SUMAST;

	//DISPONIBLES AL 10/04/2014
	private String SUMF01;
	private String SUMF02;
	

	public String getSUMUSR() {
		return SUMUSR;
	}
	public void setSUMUSR(String sUMUSR) {
		SUMUSR = sUMUSR;
	}
	public String getSUMFLG() {
		return SUMFLG;
	}
	public void setSUMFLG(String sUMFLG) {
		SUMFLG = sUMFLG;
	}
	public String getSUMTYP() {
		return SUMTYP;
	}
	public void setSUMTYP(String sUMTYP) {
		SUMTYP = sUMTYP;
	}
	public String getSUMDSC() {
		return SUMDSC;
	}
	public void setSUMDSC(String sUMDSC) {
		SUMDSC = sUMDSC;
	}
	public String getSUMACN() {
		return SUMACN;
	}
	public void setSUMACN(String sUMACN) {
		SUMACN = sUMACN;
	}
	public String getSUMBAL() {
		return SUMBAL;
	}
	public void setSUMBAL(String sUMBAL) {
		SUMBAL = sUMBAL;
	}
	public String getSUMAVB() {
		return SUMAVB;
	}
	public void setSUMAVB(String sUMAVB) {
		SUMAVB = sUMAVB;
	}
	public String getSUMCCY() {
		return SUMCCY;
	}
	public void setSUMCCY(String sUMCCY) {
		SUMCCY = sUMCCY;
	}
	public String getSUMNNM() {
		return SUMNNM;
	}
	public void setSUMNNM(String sUMNNM) {
		SUMNNM = sUMNNM;
	}
	public String getSUMFIR() {
		return SUMFIR;
	}
	public void setSUMFIR(String sUMFIR) {
		SUMFIR = sUMFIR;
	}
	public String getSUMNEM() {
		return SUMNEM;
	}
	public void setSUMNEM(String sUMNEM) {
		SUMNEM = sUMNEM;
	}
	public String getSUMAST() {
		return SUMAST;
	}
	public void setSUMAST(String sUMAST) {
		SUMAST = sUMAST;
	}
	public String getSUMF01() {
		return SUMF01;
	}
	public void setSUMF01(String sUMF01) {
		SUMF01 = sUMF01;
	}
	public String getSUMF02() {
		return SUMF02;
	}
	public void setSUMF02(String sUMF02) {
		SUMF02 = sUMF02;
	}
}
