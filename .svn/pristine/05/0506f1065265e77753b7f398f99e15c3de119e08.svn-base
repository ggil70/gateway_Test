package com.activo.gateway.beans;

/**
 * 
 *Clase para manejar la respuesta al hacer login en el IB Anterior
 *
 */
public class PWDDSJVResponse extends WSResponse {
	
	/**
	 * Parámetro para manejar la Respuesta al hacer Login en el IB Anterior
	 */
	private PWDDSJVBean PWDDSJV;

	public PWDDSJVBean getPWDDSJV() {
		return PWDDSJV;
	}

	public void setPWDDSJV(PWDDSJVBean pWDDSJV) {
		PWDDSJV = pWDDSJV;
	}
}
